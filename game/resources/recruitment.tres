[resource]
script = ExtResource("catalog")
worker_costs = Array[ExtResource("amount")]([SubResource("worker")])
carrier_costs = Array[ExtResource("amount")]([SubResource("carrier")])
warrior_costs = Array[ExtResource("amount")]([SubResource("warrior_food"), SubResource("warrior_wood"), SubResource("warrior_stone")])
