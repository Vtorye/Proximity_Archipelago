[gd_resource type="Resource" script_class="RecruitmentCatalog" format=3 uid="uid://g1ptj2hw1fig"]

[ext_resource type="Script" uid="uid://dohq4yj0b3afb" path="res://game/resources/resource_amount.gd" id="amount"]
[ext_resource type="Script" uid="uid://daa0e541gk7nm" path="res://game/resources/recruitment_catalog.gd" id="catalog"]
[ext_resource type="Resource" uid="uid://bc4vd8o7qyldd" path="res://game/resources/dot_treses/food.tres" id="food"]
[ext_resource type="Resource" path="res://game/resources/dot_treses/stone.tres" id="stone"]
[ext_resource type="Resource" path="res://game/resources/dot_treses/wood.tres" id="wood"]

[sub_resource type="Resource" id="carrier"]
script = ExtResource("amount")
