[gd_scene format=3]

[ext_resource type="Script" path="res://game/tasks/ui/task_request.gd" id="script"]
[sub_resource type="StyleBoxFlat" id="group_style"]
content_margin_left = 4.0
content_margin_top = 0.0
content_margin_right = 4.0
content_margin_bottom = 0.0
bg_color = Color(0.125, 0.125, 0.125, 1)
border_width_left = 1
border_width_right = 1
border_color = Color(0.38, 0.38, 0.38, 1)

[node name="Request" type="PanelContainer"]
script = ExtResource("script")
theme_override_styles/panel = SubResource("group_style")

[node name="Content" type="VBoxContainer" parent="."]
theme_override_constants/separation = 0

[node name="Title" type="Label" parent="Content"]
unique_name_in_owner = true
theme_type_variation = &"Caption"
mouse_filter = 1
horizontal_alignment = 1
theme_override_colors/font_color = Color(0.8745, 0.7765, 0.5451, 1)
text = "Lvl 1 (1)"

[node name="Offers" type="HBoxContainer" parent="Content"]
unique_name_in_owner = true
alignment = 1
theme_override_constants/separation = 4
