[gd_scene format=3]

[ext_resource type="Texture2D" path="res://graphics/ui/theme/textures/paper_fine_selected.png" id="paper_selected"]

[ext_resource type="Script" path="res://game/tasks/ui/task_offer.gd" id="script"]
[ext_resource type="PackedScene" path="res://game/building/ui/construction_card.tscn" id="card"]

[sub_resource type="StyleBoxTexture" id="selected"]
texture_margin_left = 4.0
texture_margin_top = 4.0
texture_margin_right = 4.0
texture_margin_bottom = 4.0
content_margin_left = 0.0
content_margin_top = 0.0
content_margin_right = 0.0
content_margin_bottom = 0.0
axis_stretch_horizontal = 1
axis_stretch_vertical = 1
texture = ExtResource("paper_selected")

[node name="TaskOffer" type="VBoxContainer"]
theme_override_constants/separation = 0
script = ExtResource("script")
selected_frame = SubResource("selected")

[node name="Placement" parent="." instance=ExtResource("card")]
unique_name_in_owner = true
custom_minimum_size = Vector2(44, 32)
size_flags_horizontal = 4
theme_override_styles/pressed = SubResource("selected")
theme_override_styles/hover_pressed = SubResource("selected")

[node name="Margin" parent="Placement" index="0"]
theme_override_constants/margin_left = 2
theme_override_constants/margin_top = 1
theme_override_constants/margin_right = 2
theme_override_constants/margin_bottom = 0

[node name="Image" parent="Placement/Margin/Content/Artwork" index="1"]
custom_minimum_size = Vector2(16, 16)

[node name="Cost" parent="Placement/Margin/Content" index="1"]
theme_type_variation = &"PriceCaption"

[node name="Reward" type="RichTextLabel" parent="."]
unique_name_in_owner = true
mouse_filter = 2
fit_content = true
scroll_active = false
autowrap_mode = 0
horizontal_alignment = 1
theme_override_font_sizes/normal_font_size = 11
theme_override_colors/default_color = Color(0.77, 0.9, 0.61, 1)

[editable path="Placement"]
