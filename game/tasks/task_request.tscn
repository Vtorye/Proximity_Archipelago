[gd_scene format=3]


[node name="Request" type="VBoxContainer"]
theme_override_constants/separation = 3

[node name="Title" type="Label" parent="."]
theme_type_variation = &"Caption"
mouse_filter = 2
text = ""
text_overrun_behavior = 3

[node name="Cost" type="Label" parent="."]
theme_type_variation = &"Caption"
mouse_filter = 2
text = ""
autowrap_mode = 3

[node name="Actions" type="HBoxContainer" parent="."]
theme_override_constants/separation = 3

[node name="Submit" type="Button" parent="Actions"]
theme_type_variation = &"CompactButton"
unique_name_in_owner = true
mouse_default_cursor_shape = 2
text = ""
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 22)

[node name="Cancel" type="Button" parent="Actions"]
theme_type_variation = &"CompactButton"
unique_name_in_owner = true
mouse_default_cursor_shape = 2
text = "ui.task.cancel"
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 22)
