[gd_resource type="Resource" script_class="TaskSpec" format=3]

[ext_resource type="Script" path="res://game/tasks/task_spec.gd" id="task"]
[ext_resource type="Resource" path="res://game/building/options/statue.tres" id="statue"]
[ext_resource type="Resource" path="res://game/building/options/feast.tres" id="feast"]
[ext_resource type="Script" path="res://game/resources/resource_amount.gd" id="amount"]
[ext_resource type="Resource" path="res://game/resources/dot_treses/royal.tres" id="royal"]
[ext_resource type="Resource" path="res://game/building/options/sawmill.tres" id="unlock"]
[ext_resource type="Script" path="res://game/building/build_option.gd" id="build_option"]

[sub_resource type="Resource" id="reward"]
script = ExtResource("amount")
type = ExtResource("royal")
amount = 1

[resource]
script = ExtResource("task")
id = &"feast_statue_d"
title = "ui.task.request_feast"
reward_seconds = 25.0
diversion_reward_seconds = 15.0
building = ExtResource("feast")
diversion = ExtResource("statue")
building_label = "ui.building.feast"
diversion_label = "ui.building.statue_placeholder"
rewards = Array[ExtResource("amount")]([SubResource("reward")])
unlocks = Array[ExtResource("build_option")]([ExtResource("unlock")])
