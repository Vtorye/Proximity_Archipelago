[gd_resource type="Resource" script_class="TaskDeck" format=3]

[ext_resource type="Script" path="res://game/tasks/task_stage.gd" id="stage"]
[ext_resource type="Script" path="res://game/tasks/task_deck.gd" id="deck"]
[ext_resource type="Script" path="res://game/tasks/task_spec.gd" id="task"]
[ext_resource type="Resource" path="res://game/building/options/road_plus.tres" id="road_plus"]
[ext_resource type="Resource" path="res://game/building/options/road.tres" id="road"]
[ext_resource type="Resource" path="res://game/tasks/request_statue_feast.tres" id="q0"]
[ext_resource type="Resource" path="res://game/tasks/request_quarry_feast.tres" id="q1"]
[ext_resource type="Resource" path="res://game/tasks/request_farm_feast.tres" id="q2"]
[ext_resource type="Resource" path="res://game/tasks/request_sawmill_feast.tres" id="q3"]
[ext_resource type="Resource" path="res://game/tasks/request_house_feast.tres" id="q4"]
[ext_resource type="Resource" path="res://game/tasks/request_canteen_feast.tres" id="q5"]
[ext_resource type="Resource" path="res://game/tasks/request_statue_feast_b.tres" id="q6"]
[ext_resource type="Resource" path="res://game/tasks/request_feast_statue_b.tres" id="q7"]
[ext_resource type="Resource" path="res://game/tasks/request_statue_feast_c.tres" id="q8"]
[ext_resource type="Resource" path="res://game/tasks/request_feast_statue_c.tres" id="q9"]
[ext_resource type="Resource" path="res://game/tasks/request_statue_feast_d.tres" id="q10"]
[ext_resource type="Resource" path="res://game/tasks/request_feast_statue_d.tres" id="q11"]
[ext_resource type="Resource" path="res://game/tasks/request_statue_feast_e.tres" id="q12"]
[ext_resource type="Resource" path="res://game/tasks/request_feast_statue_e.tres" id="q13"]
[ext_resource type="Resource" path="res://game/tasks/request_statue_feast_f.tres" id="q14"]

[sub_resource type="Resource" id="stage_1"]
script = ExtResource("stage")
tasks = Array[ExtResource("task")]([ExtResource("q0"), ExtResource("q1"), ExtResource("q2"), ExtResource("q3"), ExtResource("q4")])

[sub_resource type="Resource" id="stage_2"]
script = ExtResource("stage")
tasks = Array[ExtResource("task")]([ExtResource("q5"), ExtResource("q6"), ExtResource("q7"), ExtResource("q8"), ExtResource("q9")])

[sub_resource type="Resource" id="stage_3"]
script = ExtResource("stage")
tasks = Array[ExtResource("task")]([ExtResource("q10"), ExtResource("q11"), ExtResource("q12"), ExtResource("q13"), ExtResource("q14")])

[resource]
script = ExtResource("deck")
requests = Array[ExtResource("task")]([ExtResource("q0"), ExtResource("q1"), ExtResource("q2"), ExtResource("q3"), ExtResource("q4"), ExtResource("q5"), ExtResource("q6"), ExtResource("q7"), ExtResource("q8"), ExtResource("q9"), ExtResource("q10"), ExtResource("q11"), ExtResource("q12"), ExtResource("q13"), ExtResource("q14")])
stages = Array[ExtResource("stage")]([SubResource("stage_1"), SubResource("stage_2"), SubResource("stage_3")])
choose_upgrades = true
loop_last_stage = true
unlocked_road = ExtResource("road_plus")
replaced_road = ExtResource("road")
