[gd_scene format=3]

[ext_resource type="Script" path="res://game/tasks/task_panel.gd" id="script"]
[ext_resource type="PackedScene" path="res://game/ui/window_header.tscn" id="window_header"]

[node name="TaskPanel" type="PanelContainer"]
script = ExtResource("script")
metadata/ui_manual_layout = true

[node name="WindowContents" type="VBoxContainer" parent="."]
theme_override_constants/separation = 3

[node name="WindowHeader" parent="WindowContents" node_paths=PackedStringArray("panel", "body") instance=ExtResource("window_header")]
unique_name_in_owner = true
title = "ui.window.tasks"
dock = 3
panel_width = 198.0
inset = Vector2(8, 147)
panel = NodePath("../..")
body = NodePath("../Scroll")

[node name="Scroll" type="ScrollContainer" parent="WindowContents"]
custom_minimum_size = Vector2(0, 120)
horizontal_scroll_mode = 0

[node name="Inset" type="MarginContainer" parent="WindowContents/Scroll"]
size_flags_horizontal = 3
theme_override_constants/margin_right = 8

[node name="Content" type="VBoxContainer" parent="WindowContents/Scroll/Inset"]
unique_name_in_owner = true
theme_override_constants/separation = 3

[node name="Heading" type="Label" parent="WindowContents/Scroll/Inset/Content"]
theme_type_variation = &"Caption"
unique_name_in_owner = true
mouse_filter = 2
text = "Level 1 · 0/5"
theme_override_colors/font_color = Color(0.8745, 0.7765, 0.5451, 1)

[node name="Requests" type="VBoxContainer" parent="WindowContents/Scroll/Inset/Content"]
unique_name_in_owner = true
theme_override_constants/separation = 3

[node name="Message" type="Label" parent="WindowContents/Scroll/Inset/Content"]
theme_type_variation = &"Caption"
unique_name_in_owner = true
mouse_filter = 2
text = "ui.task.cancel_notice"
theme_override_colors/font_color = Color(0.6667, 0.651, 0.6118, 1)
autowrap_mode = 3

[node name="Waiting" type="Label" parent="WindowContents/Scroll/Inset/Content"]
theme_type_variation = &"Caption"
unique_name_in_owner = true
mouse_filter = 2
text = "Waiting for space: 1 · for supplies: 2"
theme_override_colors/font_color = Color(0.6667, 0.651, 0.6118, 1)
autowrap_mode = 3
visible = false
