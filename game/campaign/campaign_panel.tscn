[gd_scene format=3]

[ext_resource type="Script" path="res://game/campaign/campaign_panel.gd" id="script"]
[ext_resource type="StyleBox" path="res://game/ui/dialog_panel.tres" id="dialog_style"]
[ext_resource type="PackedScene" path="res://game/ui/window_header.tscn" id="window_header"]

[node name="Campaign" type="Control"]
script = ExtResource("script")
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
process_mode = 3
visible = false

[node name="Shade" type="ColorRect" parent="."]
