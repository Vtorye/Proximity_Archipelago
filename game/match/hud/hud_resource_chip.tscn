[gd_scene format=3]

[ext_resource type="Script" path="res://game/match/hud/hud_resource_chip.gd" id="script"]

[node name="ResourceChip" type="HBoxContainer"]
script = ExtResource("script")
size_flags_horizontal = 1
theme_override_constants/separation = 4

[node name="Icon" type="TextureRect" parent="."]
