[gd_resource type="Resource" script_class="WaveRules" format=3]
[ext_resource type="Script" path="res://game/combat/wave_rules.gd" id="rules"]
[ext_resource type="Script" path="res://game/resources/resource_amount.gd" id="amount"]
[ext_resource type="Resource" path="res://game/resources/dot_treses/wood.tres" id="wood"]
[ext_resource type="Resource" path="res://game/resources/dot_treses/stone.tres" id="stone"]
[sub_resource type="Resource" id="wood_cost"]
script = ExtResource("amount")
type = ExtResource("wood")
amount = 2
[sub_resource type="Resource" id="stone_cost"]
script = ExtResource("amount")
type = ExtResource("stone")
amount = 1
[resource]
script = ExtResource("rules")
trap_removal_costs = Array[ExtResource("amount")]([SubResource("wood_cost"), SubResource("stone_cost")])
