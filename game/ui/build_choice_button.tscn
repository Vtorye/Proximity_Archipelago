[gd_scene format=3]

[ext_resource type="Script" path="res://game/ui/build_choice_button.gd" id="script"]

[node name="BuildChoice" type="Button"]
script = ExtResource("script")
mouse_default_cursor_shape = 2

[node name="Body" type="MarginContainer" parent="."]
unique_name_in_owner = true
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_top = 4
theme_override_constants/margin_bottom = 4

[node name="Row" type="HBoxContainer" parent="Body"]
theme_override_constants/separation = 4
mouse_filter = 2

[node name="Icon" type="TextureRect" parent="Body/Row"]
unique_name_in_owner = true
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="Lines" type="VBoxContainer" parent="Body/Row"]
theme_override_constants/separation = 0
mouse_filter = 2
size_flags_horizontal = 3

[node name="Caption" type="Label" parent="Body/Row/Lines"]
unique_name_in_owner = true
mouse_filter = 2
text = ""
theme_override_font_sizes/font_size = 16
text_overrun_behavior = 3

[node name="Cost" type="Label" parent="Body/Row/Lines"]
unique_name_in_owner = true
mouse_filter = 2
text = ""
theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.6667, 0.651, 0.6118, 1)
autowrap_mode = 3
