[gd_scene format=3]
[ext_resource type="Script" path="res://story/chapter_panel.gd" id="script"]
[ext_resource type="StyleBox" path="res://game/ui/dialog_panel.tres" id="style"]

[sub_resource type="Animation" id="execution"]
resource_name = "execution"
length = 0.7
tracks/0/type = "value"
tracks/0/path = NodePath("ExecutionFlash:color")
tracks/0/keys = {"times": PackedFloat32Array(0, 0.12, 0.7), "transitions": PackedFloat32Array(1, 1, 1), "update": 0, "values": [Color(0.5, 0.02, 0.01, 0), Color(0.5, 0.02, 0.01, 0.6), Color(0.5, 0.02, 0.01, 0)]}
[sub_resource type="AnimationLibrary" id="library"]
_data = {&"execution": SubResource("execution")}

[node name="ChapterPanel" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
script = ExtResource("script")

[node name="Conversations" type="PanelContainer" parent="."]
unique_name_in_owner = true
offset_left = 8.0
offset_top = 118.0
offset_right = 156.0
theme_override_styles/panel = ExtResource("style")

[node name="Content" type="VBoxContainer" parent="Conversations"]

[node name="Toggle" type="Button" parent="Conversations/Content"]
unique_name_in_owner = true
toggle_mode = true
button_pressed = true
text = "ui.chapter.conversations"

[node name="People" type="VBoxContainer" parent="Conversations/Content"]
unique_name_in_owner = true

[node name="Queen" type="Button" parent="Conversations/Content/People"]
unique_name_in_owner = true

[node name="Planner" type="Button" parent="Conversations/Content/People"]
unique_name_in_owner = true

[node name="Courier" type="Button" parent="Conversations/Content/People"]
unique_name_in_owner = true

[node name="Worker" type="Button" parent="Conversations/Content/People"]
unique_name_in_owner = true

[node name="Objectives" type="PanelContainer" parent="."]
unique_name_in_owner = true
anchor_left = 0.5
anchor_right = 0.5
offset_left = -156.0
offset_right = 72.0
offset_top = 52.0
theme_override_styles/panel = ExtResource("style")

[node name="Content" type="VBoxContainer" parent="Objectives"]

[node name="GoalScroll" type="ScrollContainer" parent="Objectives/Content"]
custom_minimum_size = Vector2(0, 92)
horizontal_scroll_mode = 0

[node name="Goal" type="Label" parent="Objectives/Content/GoalScroll"]
unique_name_in_owner = true
size_flags_horizontal = 3
autowrap_mode = 3

[node name="Evacuate" type="Button" parent="Objectives/Content"]
unique_name_in_owner = true
text = "ui.chapter.evacuate"

[node name="ExecutionFlash" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(0.5, 0.02, 0.01, 0)

[node name="Effects" type="AnimationPlayer" parent="."]
unique_name_in_owner = true
libraries = {&"": SubResource("library")}
