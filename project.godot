[internationalization]

locale/translations=PackedStringArray("res://visual_novel/localization/keys.en.translation", "res://visual_novel/localization/keys.ru.translation")
locale/translations_pot_files=PackedStringArray("res://visual_novel/chapters/tutorial/tutorial.dialogue", "res://visual_novel/chapters/first/first_chapter.dialogue", "res://visual_novel/chapters/zero/zero_chapter.dialogue")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.067, 0.114, 0.114, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
