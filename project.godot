; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="archipelago"
run/main_scene="res://game/application/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://graphics/ui/icons/project_icon.svg"

[autoload]

AppSettings="*res://game/application/autoload/app_settings.tscn"
Router="*res://game/application/autoload/router.gd"
PauseController="*res://game/application/autoload/pause_controller.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/size/min_width=640
window/size/min_height=360

[editor_plugins]

enabled=PackedStringArray("res://addons/level_validation/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg")

[file_customization]

folder_colors={
"res://game/application/": "gray"
}

[gui]

theme/custom="res://graphics/ui/theme/colony_theme.tres"

