[gd_scene format=3]

[ext_resource type="Script" path="res://overlays/construction_menu.gd" id="script"]
[ext_resource type="StyleBox" path="res://game/ui/dialog_panel.tres" id="dialog_style"]
[ext_resource type="Texture2D" path="res://game/assets/ui/build_cancel.svg" id="cancel_icon"]
[ext_resource type="PackedScene" path="res://game/ui/window_header.tscn" id="window_header"]

[ext_resource type="PackedScene" path="res://game/ui/construction_card.tscn" id="preview_card"]

[sub_resource type="ButtonGroup" id="tools"]
resource_local_to_scene = true

[node name="ConstructionMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("script")

[node name="Panel" type="PanelContainer" parent="."]
offset_bottom = -42.0
offset_right = 568.0
offset_top = -188.0
offset_left = 8.0
anchor_bottom = 1.0
anchor_top = 1.0
unique_name_in_owner = true
theme_override_styles/panel = ExtResource("dialog_style")
metadata/ui_manual_layout = true

[node name="WindowContents" type="VBoxContainer" parent="Panel"]
theme_override_constants/separation = 3

[node name="PaletteHeader" parent="Panel/WindowContents" node_paths=PackedStringArray("panel", "body") instance=ExtResource("window_header")]
unique_name_in_owner = true
title = "ui.construction.title"
action = 1
dock = 1
panel_width = 560.0
collapsed_width = 210.0
draggable = false
inset = Vector2(8, 6)
panel = NodePath("../..")
body = NodePath("../Body")

[node name="Body" type="VBoxContainer" parent="Panel/WindowContents"]
