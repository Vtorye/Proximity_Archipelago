[gd_scene format=3]

[ext_resource type="Script" path="res://game/ui/ui_text_binding.gd" id="binding"]
[ext_resource type="Script" path="res://overlays/construction_menu.gd" id="script"]
[ext_resource type="StyleBox" path="res://game/ui/dialog_panel.tres" id="style"]
[ext_resource type="StyleBox" path="res://game/ui/construction_strip.tres" id="strip_style"]
[ext_resource type="Texture2D" path="res://game/assets/ui/build_cancel.svg" id="cancel_icon"]
[ext_resource type="PackedScene" path="res://game/ui/construction_card.tscn" id="card"]

[ext_resource type="PackedScene" path="res://game/ui/build_details_panel.tscn" id="details"]

[sub_resource type="ButtonGroup" id="tools"]
resource_local_to_scene = true

[node name="ConstructionMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("script")

[node name="Panel" type="PanelContainer" parent="."]
unique_name_in_owner = true
theme_override_styles/panel = ExtResource("style")

[node name="CategoryContent" type="VBoxContainer" parent="Panel"]
theme_override_constants/separation = 3

[node name="CategoryScroll" type="ScrollContainer" parent="Panel/CategoryContent"]
unique_name_in_owner = true
horizontal_scroll_mode = 0
follow_focus = true

[node name="CategoryList" type="VBoxContainer" parent="Panel/CategoryContent/CategoryScroll"]
unique_name_in_owner = true
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="PreviewCategory" type="Button" parent="Panel/CategoryContent/CategoryScroll/CategoryList"]
unique_name_in_owner = true
text = "ui.construction.category.defense"

[node name="Cost" type="RichTextLabel" parent="Panel/CategoryContent"]
unique_name_in_owner = true
mouse_filter = 2
text = "Plan: 0 · —"
size_flags_horizontal = 3
fit_content = true
scroll_active = false
autowrap_mode = 0
horizontal_alignment = 1

[node name="PlanReward" type="RichTextLabel" parent="Panel/CategoryContent"]
unique_name_in_owner = true
visible = false
mouse_filter = 2
fit_content = true
scroll_active = false
horizontal_alignment = 1
theme_override_colors/default_color = Color(0.77, 0.9, 0.61, 1)

[node name="Status" type="Label" parent="Panel/CategoryContent"]
theme_type_variation = &"Caption"
unique_name_in_owner = true
mouse_filter = 2
text = "ui.storage.protected"
theme_override_colors/font_color = Color(0.8471, 0.5451, 0.4745, 1)
autowrap_mode = 3
horizontal_alignment = 1
visible = false

[node name="Confirmation" type="HBoxContainer" parent="Panel/CategoryContent"]
unique_name_in_owner = true
theme_override_constants/separation = 4
visible = false

[node name="ConfirmLabel" type="Label" parent="Panel/CategoryContent/Confirmation"]
theme_type_variation = &"Caption"
unique_name_in_owner = true
mouse_filter = 2
text = ""
theme_override_colors/font_color = Color(0.8471, 0.5451, 0.4745, 1)
size_flags_horizontal = 3
autowrap_mode = 3
horizontal_alignment = 1

[node name="Confirm" type="Button" parent="Panel/CategoryContent/Confirmation"]
unique_name_in_owner = true
theme_type_variation = &"CompactButton"
custom_minimum_size = Vector2(0, 27)
size_flags_vertical = 4
mouse_default_cursor_shape = 2
text = "ui.build.confirm"

[node name="KeepResidents" type="Button" parent="Panel/CategoryContent/Confirmation"]
unique_name_in_owner = true
theme_type_variation = &"CompactButton"
custom_minimum_size = Vector2(27, 27)
size_flags_vertical = 4
mouse_default_cursor_shape = 2
text = ""
tooltip_text = "ui.window.close"
icon = ExtResource("cancel_icon")
expand_icon = true
theme_override_constants/icon_max_width = 14

[node name="PlanActions" type="VBoxContainer" parent="Panel/CategoryContent"]
theme_override_constants/separation = 2

[node name="Demolish" type="Button" parent="Panel/CategoryContent/PlanActions"]
unique_name_in_owner = true
theme_type_variation = &"CompactButton"
text = "ui.construction.demolish_short"
tooltip_text = "ui.construction.demolish"
toggle_mode = true
mouse_default_cursor_shape = 2

[node name="Apply" type="Button" parent="Panel/CategoryContent/PlanActions"]
unique_name_in_owner = true
theme_type_variation = &"CompactButton"
text = "ui.construction.apply"
disabled = true
mouse_default_cursor_shape = 2

[node name="Cancel" type="Button" parent="Panel/CategoryContent/PlanActions"]
unique_name_in_owner = true
theme_type_variation = &"CompactButton"
text = "ui.construction.cancel"
mouse_default_cursor_shape = 2

[node name="BuildingsPanel" type="PanelContainer" parent="."]
unique_name_in_owner = true
visible = false
theme_override_styles/panel = ExtResource("strip_style")

[node name="Buildings" type="ScrollContainer" parent="BuildingsPanel"]
unique_name_in_owner = true
horizontal_scroll_mode = 1
vertical_scroll_mode = 0

[node name="Choices" type="HBoxContainer" parent="BuildingsPanel/Buildings"]
unique_name_in_owner = true
alignment = 1
theme_override_constants/separation = 4

[node name="PreviewCard" parent="BuildingsPanel/Buildings/Choices" instance=ExtResource("card")]
unique_name_in_owner = true
button_group = SubResource("tools")

[node name="DescriptionPanel" parent="." instance=ExtResource("details")]
unique_name_in_owner = true

[node name="UiText" type="Node" parent="." node_paths=PackedStringArray("target")]
script = ExtResource("binding")
target = NodePath("..")
