[gd_scene format=3]
[ext_resource type="Script" path="res://overlays/match_result.gd" id="script"]
[ext_resource type="StyleBox" path="res://game/ui/dialog_panel.tres" id="dialog_style"]

[node name="MatchResult" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("script")

[node name="Shade" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.5)

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Dialog" type="PanelContainer" parent="Center"]
unique_name_in_owner = true
custom_minimum_size = Vector2(384, 0)
theme_override_styles/panel = ExtResource("dialog_style")

[node name="Margin" type="MarginContainer" parent="Center/Dialog"]
theme_override_constants/margin_left = 6
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 6
theme_override_constants/margin_bottom = 6

[node name="Content" type="VBoxContainer" parent="Center/Dialog/Margin"]
unique_name_in_owner = true
theme_override_constants/separation = 8

[node name="Heading" type="Label" parent="Center/Dialog/Margin/Content"]
unique_name_in_owner = true
mouse_filter = 2
text = ""
theme_override_font_sizes/font_size = 24
theme_override_colors/font_color = Color(0.8745, 0.7765, 0.5451, 1)

[node name="Reason" type="Label" parent="Center/Dialog/Margin/Content"]
unique_name_in_owner = true
mouse_filter = 2
text = ""
theme_override_font_sizes/font_size = 16

[node name="Resources" type="VBoxContainer" parent="Center/Dialog/Margin/Content"]
unique_name_in_owner = true
theme_override_constants/separation = 8

[node name="TimeLeft" type="Label" parent="Center/Dialog/Margin/Content"]
unique_name_in_owner = true
mouse_filter = 2
text = ""
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(0.6667, 0.651, 0.6118, 1)
visible = false

[node name="Level" type="Label" parent="Center/Dialog/Margin/Content"]
unique_name_in_owner = true
mouse_filter = 2
text = ""
theme_override_font_sizes/font_size = 16
visible = false

[node name="Completed" type="Label" parent="Center/Dialog/Margin/Content"]
unique_name_in_owner = true
mouse_filter = 2
text = ""
theme_override_font_sizes/font_size = 16
visible = false

[node name="Again" type="Button" parent="Center/Dialog/Margin/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 28)
mouse_default_cursor_shape = 2
text = "ui.result.new_game"
theme_override_colors/font_color = Color(0.8745, 0.7765, 0.5451, 1)

[node name="MainMenu" type="Button" parent="Center/Dialog/Margin/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 28)
mouse_default_cursor_shape = 2
text = "ui.common.main_menu"
