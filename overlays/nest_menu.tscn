[gd_scene format=3]

[ext_resource type="Script" path="res://overlays/nest_menu.gd" id="script"]
[ext_resource type="StyleBox" path="res://game/ui/dialog_panel.tres" id="dialog_style"]
[ext_resource type="PackedScene" path="res://game/ui/window_header.tscn" id="window_header"]

[sub_resource type="ButtonGroup" id="tabs"]
resource_local_to_scene = true

[node name="NestMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("script")
mouse_filter = 2

[node name="Center" type="Control" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Dialog" type="PanelContainer" parent="Center"]
unique_name_in_owner = true
metadata/ui_manual_layout = true
theme_override_styles/panel = ExtResource("dialog_style")

[node name="WindowContents" type="VBoxContainer" parent="Center/Dialog"]
theme_override_constants/separation = 2

[node name="WindowHeader" parent="Center/Dialog/WindowContents" node_paths=PackedStringArray("panel", "body") instance=ExtResource("window_header")]
unique_name_in_owner = true
title = "ui.window.nest"
action = 2
dock = 4
panel_width = 340.0
inset = Vector2(6, 64)
panel = NodePath("../..")
body = NodePath("../Margin")

[node name="Margin" type="MarginContainer" parent="Center/Dialog/WindowContents"]
theme_override_constants/margin_left = 4
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 4
theme_override_constants/margin_bottom = 4

[node name="Content" type="VBoxContainer" parent="Center/Dialog/WindowContents/Margin"]
unique_name_in_owner = true
theme_override_constants/separation = 5

[node name="Header" type="HBoxContainer" parent="Center/Dialog/WindowContents/Margin/Content"]

[node name="Title" type="Label" parent="Center/Dialog/WindowContents/Margin/Content/Header"]
theme_type_variation = &"Heading"
unique_name_in_owner = true
mouse_filter = 2
text = "ui.storage.main"
theme_override_colors/font_color = Color(0.8745, 0.7765, 0.5451, 1)
size_flags_horizontal = 3

[node name="Tabs" type="HBoxContainer" parent="Center/Dialog/WindowContents/Margin/Content"]

[node name="Inventory" type="Button" parent="Center/Dialog/WindowContents/Margin/Content/Tabs"]
